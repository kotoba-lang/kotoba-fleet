;; nbb reads this file and does NOT read deps.edn. The .cljs in this repo are
;; run as bare `nbb <script>` with no --classpath, so a coordinate that lives
;; only in deps.edn is invisible to them: measured 2026-09-09, after the
;; clojure.string -> kotoba.lang.text migration wrote the dependency to
;; deps.edn and `kbb --backend sci tools/coverage_report.cljk` answered
;; "Could not find namespace: kotoba.lang.text".
;;
;; :paths mirrors deps.edn's rather than being invented.
{:paths ["src" "hosts/nbb"]
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}io.github.kotoba-lang/text {:git/sha "2ee6dce2ca944decd001f9378868dd703fc3e741"}}}
